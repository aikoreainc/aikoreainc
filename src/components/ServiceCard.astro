---
import type { Lang } from "../data/company";
import type { Service } from "../data/services";

interface Props {
  service: Service;
  lang: Lang;
}

const { service, lang } = Astro.props;
const products = service.products ?? [];

const t = {
  ko: { visit: "사이트 방문", ask: "문의하기", contact: "/contact/" },
  en: { visit: "Visit site", ask: "Contact us", contact: "/en/contact/" },
}[lang];

// 네 장의 카드가 같은 클릭 모델을 갖는다 —
// 카드 자체는 링크가 아니고, 맨 아래의 명시적 링크만 이동한다.
const cardClass =
  "flex h-full flex-col rounded-2xl border border-(--color-ink-200) bg-white p-7 transition-colors duration-200 hover:border-(--color-brand-400) sm:p-8";
---

<div class={cardClass}>
  <h3 class="text-lg font-bold text-(--color-ink-900) sm:text-xl">
    {service.title[lang]}
  </h3>
  <p class="mt-3 text-sm leading-relaxed text-(--color-ink-600) sm:text-base">
    {service.summary[lang]}
  </p>
  <ul class="mt-5 space-y-2">
    {
      service.highlights[lang].map((h) => (
        <li class="flex items-start gap-2.5 text-sm leading-relaxed text-(--color-ink-700)">
          <span
            class="mt-2 inline-block h-1 w-1 shrink-0 rounded-full bg-(--color-brand-500)"
            aria-hidden="true"
          />
          <span>{h}</span>
        </li>
      ))
    }
  </ul>

  <div class="mt-auto flex flex-wrap gap-2 pt-6">
    {
      products.length > 0 ? (
        products.map((p) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 rounded-md border border-(--color-ink-200) bg-(--color-ink-50) px-3 py-1.5 text-xs font-semibold text-(--color-ink-800) transition hover:border-(--color-brand-400) hover:bg-white hover:text-(--color-brand-700)"
          >
            {p.name}
            <span class="sr-only"> — {t.visit}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-3 w-3"
              aria-hidden="true"
            >
              <path d="M7 17L17 7" />
              <polyline points="7 7 17 7 17 17" />
            </svg>
          </a>
        ))
      ) : (
        <a
          href={t.contact}
          class="inline-flex items-center gap-1.5 rounded-md border border-(--color-ink-200) bg-(--color-ink-50) px-3 py-1.5 text-xs font-semibold text-(--color-ink-800) transition hover:border-(--color-brand-400) hover:bg-white hover:text-(--color-brand-700)"
        >
          {t.ask}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-3 w-3"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
      )
    }
  </div>
</div>
